.venv/
__pycache__/
*.pyc
.env

# Terraform. The state file records everything it created — including every
# value it handled, in clear text. It is not source code and never goes here.
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/terraform.tfstate
terraform/terraform.tfstate.*
terraform/terraform.tfvars
*.pem
*.tfvars
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl
*.rendered
*.pem