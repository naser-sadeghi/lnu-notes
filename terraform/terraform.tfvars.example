# Copy to terraform.tfvars and fill in the two values. That file is git-ignored.
#   cp terraform.tfvars.example terraform.tfvars

admin_cidr  = "{YOUR_IP}/32"                              # curl -s https://checkip.amazonaws.com
repo_url    = "https://github.com/{GITHUB_NAME}/lnu-notes.git"   # must be PUBLIC

# The database password is generated by Terraform — you never type it.

# Optional — these have working defaults:
# key_name      = "2dv705"
# region        = "eu-north-1"
# instance_type = "t3.micro"
