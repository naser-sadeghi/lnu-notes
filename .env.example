# Copy to .env — the defaults below already match the local MariaDB container in
# README section 1, so the application runs as soon as you have copied this file.
# The comment on each line says what it becomes on EC2, where this file lives at
# /etc/lnu-notes.env
#
# Never put AWS access keys here. On EC2 the instance role provides them, and on
# your laptop the CLI profile does.

DB_HOST=127.0.0.1     # on EC2: the PRIVATE IPv4 address of the database instance
DB_USER=lnu           # MARIADB_USER in the docker run command
DB_PASS=lnu           # MARIADB_PASSWORD — not MARIADB_ROOT_PASSWORD
DB_NAME=lnunotes      # MARIADB_DATABASE — must match exactly

S3_BUCKET=            # empty locally; on EC2 your own globally unique bucket name
AWS_REGION=eu-north-1

MAX_UPLOAD_MB=5
