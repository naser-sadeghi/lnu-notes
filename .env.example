# Copy to .env and fill in. On EC2 this file lives at /etc/lnu-notes.env
# Never put AWS access keys here — the instance role provides them.

DB_HOST=10.0.2.51          # the private address of your database instance
DB_USER=lnu
DB_PASS=change-me
DB_NAME=lnunotes

S3_BUCKET=2dv705-yourname-notes   # bucket names are globally unique
AWS_REGION=eu-north-1

MAX_UPLOAD_MB=5
